<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="12dp"
    android:background="@drawable/bg_block_card"
    android:padding="14dp">

    <!-- DAY 1 (2026.05.23) -->
    <TextView
        android:id="@+id/tvBlockMapDayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#111111"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 지도 (동선 + 핀). liteMode 로 RecyclerView 안에서 안전하게 표시 -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/blockMapView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        map:liteMode="true"
        map:mapType="normal" />

    <!-- ①②③ 요약 리스트 -->
    <LinearLayout
        android:id="@+id/layoutBlockMapSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp" />

    <!-- 더보기 / 접기 -->
    <TextView
        android:id="@+id/btnBlockMapReadMore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="접기 ▲"
        android:textColor="#666666"
        android:textSize="14sp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_block_card" />
</LinearLayout>
